# ── 必要設定 ──────────────────────────────────────────────────────
# 對外網域（caddy 取得憑證用）；本機開發可填 localhost
DOMAIN=localhost

# 資料庫（docker compose 內部網路的預設值）
POSTGRES_PASSWORD=change-me-to-a-long-random-string
DATABASE_URL=postgresql://postgres:change-me-to-a-long-random-string@postgres:5432/ees

# JWT 簽章密鑰：至少 32 字元，請用 `openssl rand -base64 48` 產生
JWT_SECRET=

# ── 選用（有預設值） ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false          # 有 HTTPS（DOMAIN 非 localhost）時改 true

# Discovery 資訊（學生端新增伺服器時顯示）
SERVER_NAME=我的英語教室
TEACHER_NAME=
SCHOOL=
SERVER_DESCRIPTION=
SOFTWARE_VERSION=0.1.0

# ── 檔案儲存（MinIO / S3 相容） ───────────────────────────────────
# 開發（backend 在 compose 外跑）：http://localhost:9000
# compose 內部：http://minio:9000
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-too
MINIO_BUCKET=ees-attachments
